/*
 * parser.cup
 * Turbo X - Gramática JCUP mejorada.
 *
 * Mejoras incluidas:
 * 1. GRAFICAR genera URL local para desmos.html usando acción dentro de JCUP.
 * 2. La expresión de GRAFICAR acepta ecuaciones con operadores y funciones:
 *    sin(x), cos(x), tan(x), sqrt(x), abs(x), log(x), ln(x), exp(x), etc.
 * 3. La expresión se reconstruye como String para enviarla a Desmos.
 * 4. Se mantienen SI con SINO y SI sin SINO.
 */

package com.company.api_compilador;

import java_cup.runtime.Symbol;
import java.net.URLEncoder;
import java.util.regex.Pattern;

parser code {:
    public StringBuilder reporte = new StringBuilder();

    public boolean graficaEncontrada = false;
    public String funcionGrafica = "";
    public String variableGrafica = "";
    public String expresionGrafica = "";
    public String urlGrafica = "";

    @Override
    public void syntax_error(Symbol s) {
        String valor = (s == null || s.value == null) ? "sin valor" : s.value.toString();

        int linea = 1;
        int columna = 1;

        if (s != null) {
            linea = Math.max(1, s.left);
            columna = Math.max(1, s.right);
        }

        String mensaje = "Error sintáctico cerca de la línea " + linea
                + ", columna " + columna
                + ". Símbolo recibido: '" + valor + "'.";

        mensaje += " Revisa si falta ';', ')', '}', ':' o alguna palabra reservada de la estructura.";

        System.err.println(mensaje);
        reporte.append(mensaje).append("\\n");
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) throws Exception {
        String valor = (s == null || s.value == null) ? "sin valor" : s.value.toString();

        int linea = 1;
        int columna = 1;

        if (s != null) {
            linea = Math.max(1, s.left);
            columna = Math.max(1, s.right);
        }

        String mensaje = "Error sintáctico no recuperable cerca de la línea " + linea
                + ", columna " + columna
                + ". Símbolo recibido: '" + valor + "'.";

        mensaje += " El parser no pudo continuar. Revisa especialmente la línea indicada y la línea anterior.";

        System.err.println(mensaje);
        reporte.append(mensaje).append("\\n");
        throw new Exception(mensaje);
    }

    public void registrarGrafica(String nombreFuncion, String variable, String expresion) {
        this.graficaEncontrada = true;
        this.funcionGrafica = nombreFuncion;
        this.variableGrafica = variable;
        this.expresionGrafica = expresion;
        this.urlGrafica = generarUrlDesmos(variable, expresion);
    }

    private String generarUrlDesmos(String variable, String expresion) {
        try {
            String expresionNormalizada = normalizarExpresionDesmos(expresion);

            if (!"x".equalsIgnoreCase(variable)) {
                expresionNormalizada = expresionNormalizada.replaceAll(
                        "\\b" + Pattern.quote(variable) + "\\b",
                        "x"
                );
            }

            String ecuacion = "y=" + expresionNormalizada;
            String encoded = URLEncoder.encode(ecuacion, "UTF-8");

            return "/desmos.html?expr=" + encoded;

        } catch (Exception ex) {
            return "/desmos.html";
        }
    }

    private String normalizarExpresionDesmos(String expresion) {
        String expr = expresion
                .replace("**", "^")
                .replaceAll("\\s+", "");

        /*
         * Alias útiles para que el lenguaje acepte notación en español.
         * Desmos entiende sin, cos, tan, sqrt, abs, log, ln y exp.
         */
        expr = expr.replaceAll("(?i)\\bsen\\s*\\(", "sin(");
        expr = expr.replaceAll("(?i)\\braiz\\s*\\(", "sqrt(");
        expr = expr.replaceAll("(?i)\\babsoluto\\s*\\(", "abs(");

        return expr;
    }
:};

/* =========================
   TERMINALES
   ========================= */

terminal String IDENTIFICADOR;
terminal String NUMERO_ENTERO;
terminal String NUMERO_REAL;
terminal String VALOR_CADENA;
terminal String VALOR_CARACTER;
terminal String VALOR_VERDADERO;
terminal String VALOR_FALSO;

terminal PROGRAMA;
terminal INICIO;
terminal FIN;

terminal TIPO_ENTERO;
terminal TIPO_REAL;
terminal TIPO_CADENA;
terminal TIPO_CARACTER;
terminal TIPO_LOGICO;

terminal IMPRIMIR;
terminal LEER;

terminal SI;
terminal ENTONCES;
terminal SINO;
terminal SIN_SINO;
terminal MIENTRAS;
terminal HACER;

terminal EVALUAR;
terminal CASO;
terminal OTRO;
terminal PARAR;

terminal GRAFICAR;

terminal OP_ASIG;
terminal OP_SUMA;
terminal OP_RESTA;
terminal OP_MULT;
terminal OP_DIV;
terminal OP_POT;
terminal OP_MOD;

terminal IGUAL_QUE;
terminal DIFERENTE_QUE;
terminal MAYOR_QUE;
terminal MENOR_QUE;
terminal MAYOR_IGUAL;
terminal MENOR_IGUAL;

terminal OP_Y;
terminal OP_O;
terminal OP_NO;

terminal LLAVE_ABRE;
terminal LLAVE_CIERRA;
terminal PARENT_ABRE;
terminal PARENT_CIERRA;
terminal FIN_SENTENCIA;
terminal COMA;
terminal DOS_PUNTOS;

terminal ERROR;
terminal ERROR_CADENA;
terminal ERROR_CARACTER;
terminal ERROR_NUMERO;
terminal ERROR_IDENTIFICADOR;

/* =========================
   NO TERMINALES
   ========================= */

non terminal programa;
non terminal lista_instrucciones;
non terminal instruccion;

non terminal declaracion;
non terminal asignacion;
non terminal imprimir;
non terminal leer;

non terminal si;
non terminal mientras;
non terminal evaluar;
non terminal lista_casos;
non terminal caso;
non terminal caso_otro;

non terminal graficar;
non terminal bloque;

non terminal tipo;
non terminal String expr;
non terminal String argumentos;
non terminal valor_caso;

/* =========================
   PRECEDENCIAS
   De menor a mayor prioridad.
   ========================= */

precedence nonassoc SIN_SINO;
precedence nonassoc SINO;
precedence left OP_O;
precedence left OP_Y;
precedence right OP_NO;
precedence nonassoc IGUAL_QUE, DIFERENTE_QUE, MAYOR_QUE, MENOR_QUE, MAYOR_IGUAL, MENOR_IGUAL;
precedence left OP_SUMA, OP_RESTA;
precedence left OP_MULT, OP_DIV, OP_MOD;
precedence right OP_POT;

/* =========================
   SÍMBOLO INICIAL
   ========================= */

start with programa;

/* =========================
   GRAMÁTICA PRINCIPAL
   ========================= */

programa ::=
      PROGRAMA IDENTIFICADOR INICIO lista_instrucciones FIN
    ;

lista_instrucciones ::=
      lista_instrucciones instruccion
    |
    ;

instruccion ::=
      declaracion
    | asignacion
    | imprimir
    | leer
    | si
    | mientras
    | evaluar
    | graficar
    | error FIN_SENTENCIA
    | ERROR FIN_SENTENCIA
    | ERROR_CADENA FIN_SENTENCIA
    | ERROR_CARACTER FIN_SENTENCIA
    | ERROR_NUMERO FIN_SENTENCIA
    | ERROR_IDENTIFICADOR FIN_SENTENCIA
    ;

/* =========================
   DECLARACIONES Y ASIGNACIONES
   ========================= */

declaracion ::=
      tipo IDENTIFICADOR FIN_SENTENCIA
    | tipo IDENTIFICADOR OP_ASIG expr FIN_SENTENCIA
    ;

tipo ::=
      TIPO_ENTERO
    | TIPO_REAL
    | TIPO_CADENA
    | TIPO_CARACTER
    | TIPO_LOGICO
    ;

asignacion ::=
      IDENTIFICADOR OP_ASIG expr FIN_SENTENCIA
    ;

/* =========================
   ENTRADA Y SALIDA
   ========================= */

imprimir ::=
      IMPRIMIR PARENT_ABRE expr PARENT_CIERRA FIN_SENTENCIA
    ;

leer ::=
      LEER PARENT_ABRE IDENTIFICADOR PARENT_CIERRA FIN_SENTENCIA
    ;

/* =========================
   SI / SINO
   ========================= */

si ::=
      SI PARENT_ABRE expr PARENT_CIERRA ENTONCES bloque %prec SIN_SINO
    | SI PARENT_ABRE expr PARENT_CIERRA ENTONCES bloque SINO bloque
    ;

bloque ::=
      LLAVE_ABRE lista_instrucciones LLAVE_CIERRA
    ;

/* =========================
   MIENTRAS
   ========================= */

mientras ::=
      MIENTRAS PARENT_ABRE expr PARENT_CIERRA HACER bloque
    ;

/* =========================
   EVALUAR / CASO
   ========================= */

evaluar ::=
      EVALUAR PARENT_ABRE expr PARENT_CIERRA LLAVE_ABRE lista_casos caso_otro LLAVE_CIERRA
    ;

lista_casos ::=
      lista_casos caso
    | caso
    ;

caso ::=
      CASO valor_caso DOS_PUNTOS lista_instrucciones PARAR FIN_SENTENCIA
    ;

caso_otro ::=
      OTRO DOS_PUNTOS lista_instrucciones PARAR FIN_SENTENCIA
    |
    ;

valor_caso ::=
      NUMERO_ENTERO
    | NUMERO_REAL
    | VALOR_CADENA
    | VALOR_CARACTER
    | VALOR_VERDADERO
    | VALOR_FALSO
    | IDENTIFICADOR
    ;

/* =========================
   GRÁFICAS
   Código de acción dentro de JCUP.
   ========================= */

graficar ::=
      GRAFICAR IDENTIFICADOR:nombre PARENT_ABRE IDENTIFICADOR:variable PARENT_CIERRA OP_ASIG expr:expresion FIN_SENTENCIA
      {:
          registrarGrafica(nombre, variable, expresion);
      :}
    ;

/* =========================
   EXPRESIONES
   expr devuelve String para reconstruir ecuaciones.
   ========================= */

expr ::=
      expr:a OP_SUMA expr:b
      {:
          RESULT = a + " + " + b;
      :}
    | expr:a OP_RESTA expr:b
      {:
          RESULT = a + " - " + b;
      :}
    | expr:a OP_MULT expr:b
      {:
          RESULT = a + " * " + b;
      :}
    | expr:a OP_DIV expr:b
      {:
          RESULT = a + " / " + b;
      :}
    | expr:a OP_MOD expr:b
      {:
          RESULT = a + " % " + b;
      :}
    | expr:a OP_POT expr:b
      {:
          RESULT = a + " ^ " + b;
      :}

    | expr:a MAYOR_QUE expr:b
      {:
          RESULT = a + " > " + b;
      :}
    | expr:a MENOR_QUE expr:b
      {:
          RESULT = a + " < " + b;
      :}
    | expr:a MAYOR_IGUAL expr:b
      {:
          RESULT = a + " >= " + b;
      :}
    | expr:a MENOR_IGUAL expr:b
      {:
          RESULT = a + " <= " + b;
      :}
    | expr:a IGUAL_QUE expr:b
      {:
          RESULT = a + " == " + b;
      :}
    | expr:a DIFERENTE_QUE expr:b
      {:
          RESULT = a + " != " + b;
      :}

    | expr:a OP_Y expr:b
      {:
          RESULT = a + " Y " + b;
      :}
    | expr:a OP_O expr:b
      {:
          RESULT = a + " O " + b;
      :}
    | OP_NO expr:a
      {:
          RESULT = "NO " + a;
      :}

    | PARENT_ABRE expr:a PARENT_CIERRA
      {:
          RESULT = "(" + a + ")";
      :}

    /* Funciones matemáticas o llamadas tipo sin(x), sqrt(x), max(x, 2). */
    | IDENTIFICADOR:fn PARENT_ABRE argumentos:args PARENT_CIERRA
      {:
          RESULT = fn + "(" + args + ")";
      :}

    | NUMERO_ENTERO:n
      {:
          RESULT = n;
      :}
    | NUMERO_REAL:n
      {:
          RESULT = n;
      :}
    | VALOR_CADENA:c
      {:
          RESULT = c;
      :}
    | VALOR_CARACTER:c
      {:
          RESULT = c;
      :}
    | VALOR_VERDADERO:v
      {:
          RESULT = v;
      :}
    | VALOR_FALSO:v
      {:
          RESULT = v;
      :}
    | IDENTIFICADOR:id
      {:
          RESULT = id;
      :}
    ;

argumentos ::=
      expr:e
      {:
          RESULT = e;
      :}
    | argumentos:a COMA expr:e
      {:
          RESULT = a + ", " + e;
      :}
    ;
